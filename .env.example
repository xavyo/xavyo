# Xavyo Suite - Environment Configuration
# Copy this file to .env and customize for your environment.
# Quick start: `make dev` or `bash scripts/setup-dev-env.sh`

# =============================================================================
# Application
# =============================================================================
APP_ENV=development
RUST_LOG=info
HOST=0.0.0.0
PORT=8080
ISSUER_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgres://xavyo:xavyo_test_password@localhost:5434/xavyo_test
# APP_DATABASE_URL=postgres://xavyo_app:password@localhost:5434/xavyo_test

# =============================================================================
# JWT Authentication (inline PEM — generate with: bash docker/generate-keys.sh)
# =============================================================================
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=primary

# =============================================================================
# Bootstrap admin (created on first start)
# =============================================================================
ADMIN_EMAIL=admin@xavyo.local
ADMIN_PASSWORD=Admin@1234

# =============================================================================
# Governance encryption (generate: openssl rand -base64 32)
# =============================================================================
XAVYO_SIEM_ENCRYPTION_KEY=
XAVYO_TICKETING_ENCRYPTION_KEY=

# =============================================================================
# Email (Mailpit for local dev: docker compose -f docker/docker-compose.yml up -d mailpit)
# =============================================================================
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_TLS=false
EMAIL_FROM_ADDRESS=noreply@xavyo.local
EMAIL_FROM_NAME=xavyo

# =============================================================================
# Optional: Kafka (only when KAFKA_BOOTSTRAP_SERVERS is set)
# =============================================================================
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# =============================================================================
# Build tip (#99): SQLX_OFFLINE=true is set in .cargo/config.toml for local builds.
# Override with: SQLX_OFFLINE=false cargo build -p idp-api
# =============================================================================
